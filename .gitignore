# ═══════════════════════════════════════════════════════════════
#  NUNCA PUBLICAR — datos privados
#  El repositorio es PÚBLICO. Todo lo de aquí abajo se queda en
#  local. Si alguna vez editas este archivo, no toques este bloque.
# ═══════════════════════════════════════════════════════════════
PRIVADO/
*.local
*.local.*
.env
.env.*
secretos*
credenciales*
clave*.txt
*.key
*.pem

# La aplicación no tiene dependencias. Esto es solo de las pruebas.
pruebas/node_modules/
pruebas/package-lock.json

# Capturas que genera pruebas/interfaz.js
pruebas/capturas/

# GMM Server: dependencias y datos generados en este PC
gmm-server/node_modules/
gmm-server/PRIVADO/
gmm-server/*.log

# GMM Server: .exe compilados (build/Compilar.ps1 es la fuente; los binarios
# no se versionan, se generan en cada PC de desarrollo)
gmm-server/build/salida/
GMM-Server-para-instalar/*.exe

# Excepción pedida por el usuario (2026-08-17): los dos .exe propios de GMM
# Server SÍ se publican, para que un usuario final los descargue del repo sin
# tener que compilarlos. El instalador de VLC (de terceros, ~45 MB) sigue
# fuera por la regla de arriba — no se toca.
!GMM-Server-para-instalar/GMM-Server.exe
!GMM-Server-para-instalar/GMM-Instalar.exe

# Copia histórica local previa; la fuente activa vive en la raíz
Por Codex/

# Sistema
Thumbs.db
desktop.ini
.DS_Store
